# Qual provedor de IA usar: "gemini" (gratuito, aistudio.google.com/apikey) ou "anthropic" (pago)
AI_PROVIDER=gemini

# Chave do Google AI Studio, necessaria se AI_PROVIDER=gemini (gratis, sem cartao)
GEMINI_API_KEY=xxxxx

# Chave da API da Anthropic, necessaria se AI_PROVIDER=anthropic (platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Modelo usado para as respostas do atendente (padrao: gemini-2.5-flash ou claude-haiku-4-5-20251001)
AI_MODEL=

# Token que voce escolhe e cadastra no painel da Meta ao configurar o webhook
# (Meta for Developers > seu app > WhatsApp > Configuration > Verify token)
WHATSAPP_VERIFY_TOKEN=escolha-uma-string-secreta-aqui

# App Secret do app da Meta (Meta for Developers > seu app > App settings > Basic > App secret)
# usado para validar a assinatura X-Hub-Signature-256 de cada webhook recebido
WHATSAPP_APP_SECRET=xxxxx

# Porta HTTP do servidor de webhook
PORT=3000

# Caminho do arquivo SQLite (criado automaticamente se nao existir)
DATABASE_PATH=./data/atendente.db
